PORT=3000
NODE_ENV=production
# Generate a unique random secret of at least 32 characters. Never commit real secrets.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_chars
ADMIN_EMAIL=admin@example.com
# Use a strong password (12+ characters); never commit the real value.
ADMIN_PASSWORD=replace_with_a_strong_admin_password
DATABASE_PATH=./paw.db
UPLOAD_DIR=./uploads
